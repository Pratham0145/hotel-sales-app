# Copy this file to .env and adjust if needed.
PORT=5000

# Supabase Postgres connection string.
# Get this from: Supabase dashboard -> Project Settings -> Database -> Connection string.
# For Vercel (serverless), use the "Transaction" pooler mode (port 6543) —
# a direct connection (port 5432) will run out of connections fast under
# serverless concurrency. For local dev either works.
DATABASE_URL=postgresql://postgres:Pratham0145@db.kptoxlxuyekrsaauacya.supabase.co:5432/postgres

# Only needed once, if you're migrating existing data from data/hotel.db —
# leave unset otherwise. See migrate.js.
# OLD_DB_PATH=./data/hotel.db

# Shared secret Vercel Cron sends back as `Authorization: Bearer <value>` —
# set the same value here and in Vercel's project environment variables.
# Only needed if you want the automatic 2am daily report email on Vercel.
# CRON_SECRET=choose-a-random-string

# Two-tier access — see README "Passwords & access".
# WORKER_PASSWORD: outlet pages only (Food Truck / JP Nagar / Items Used),
#   and may change the date being edited.
# OWNER_PASSWORD:  everything above + Amount, Report (with date-range report)
#   and Payment.
# Leave BOTH unset to keep everything open (no restrictions at all).
# WORKER_PASSWORD=choose-a-worker-password
# OWNER_PASSWORD=choose-an-owner-password

# Daily report email (sent automatically at 2:00 AM IST) — see README "Daily report by email"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your_16_character_app_password
# REPORT_EMAIL_TO=owner@example.com
# REPORT_EMAIL_FROM="Biryani Boys Sales Book" <youraddress@gmail.com>
